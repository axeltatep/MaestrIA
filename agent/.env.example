# Higgsfield API credentials
# Get them from: https://cloud.higgsfield.ai/ → Developer Settings
HF_API_KEY=your_higgsfield_api_key_here
HF_API_SECRET=your_higgsfield_api_secret_here

# Claude API key
# Get it from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Output directory for generated files (default: ./output)
OUTPUT_DIR=./output
